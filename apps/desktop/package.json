{
  "name": "desktop",
  "version": "0.17.0",
  "description": "AI Music Studio - free, open-source music studio with local AI song and loop generation",
  "homepage": "https://github.com/pierrecinema/ai-music-studio",
  "author": "pierrecinema",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder --win nsis --publish never",
    "preview": "electron-vite preview",
    "preview:browser": "vite --config vite.browser.config.ts",
    "test": "esbuild tests/studio.test.ts --bundle --platform=node --outfile=out/tests/studio.cjs --log-level=warning && node out/tests/studio.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/renderer/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "electron-log": "^5.1.2",
    "electron-updater": "^6.1.7",
    "i18next": "^23.7.11",
    "i18next-electron-fs-backend": "^3.0.1",
    "nanoid": "^5.0.7",
    "openai": "^4.26.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.1",
    "tone": "^14.7.77",
    "webamp": "^2.3.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "electron": "29.4.6",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11"
  },
  "build": {
    "appId": "com.aimusic.studio",
    "productName": "AI Music Studio",
    "npmRebuild": false,
    "copyright": "Copyright © 2026 pierrecinema · GPL-3.0 · github.com/pierrecinema/ai-music-studio",
    "directories": {
      "output": "../../dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/.venv/**",
          "!**/tests/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "AIMusicStudio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Music Studio",
      "include": "resources/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "pierrecinema",
      "repo": "ai-music-studio"
    }
  }
}
